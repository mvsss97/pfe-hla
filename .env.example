# Copy this file to .env. Never commit .env.
# The token previously shared in chat must be revoked before configuring this.
TELEGRAM_BOT_TOKEN=

# Secure first pairing: send `/start YOUR_CODE` to the bot once.
TELEGRAM_PAIRING_CODE=replace-with-a-long-random-code
TELEGRAM_ALLOWED_CHAT_ID=

# Public URL shown by /site (optional until deployment).
PFE_SITE_URL=http://localhost:8000

# Research sources. OpenAlex asks clients to identify themselves.
OPENALEX_EMAIL=
# Reserved for a later Semantic Scholar connector; unused in the current build.
SEMANTIC_SCHOLAR_API_KEY=

# AI agents (pre-screening suggestions, reading sheets, synthesis).
# Free Google Gemini key: https://aistudio.google.com/apikey . In GitHub it is
# the GEMINI_API_KEY secret (scripts/setup-secrets.ps1 copies it from here).
# AI output stays a suggestion: screening decisions remain human.
GEMINI_API_KEY=
# Optional: AGENT_BACKEND=auto|gemini|claude and AGENT_MODEL=model1,model2
AGENT_BACKEND=auto

# Defaults
PFE_DATABASE=data/pfe_hla.db
PFE_TIMEZONE=Africa/Algiers
